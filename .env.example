# Copy this file to .env and fill in your keys. .env is gitignored.
# On GitHub Actions, the same names are set as repository secrets.

# Adzuna: developer.adzuna.com > dashboard
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Anthropic: console.anthropic.com > API keys (set a monthly spend limit too)
ANTHROPIC_API_KEY=

# Notion (optional: without it, results stay in the logs and the output folder)
# 1. notion.so/profile/integrations > New integration (internal) > copy the token
# 2. Share a page with the integration (page menu ••• > Connections)
# 3. python -m jobpipeline --setup-notion <page URL>  -> prints NOTION_DATABASE_ID
NOTION_TOKEN=
NOTION_DATABASE_ID=
