# Copy this file to .env and fill in your keys. .env is gitignored.
# On GitHub Actions, the same names are set as repository secrets.

# Adzuna: developer.adzuna.com > dashboard
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Anthropic: console.anthropic.com > API keys (set a monthly spend limit too)
ANTHROPIC_API_KEY=

# Notion: notion.so/my-integrations > internal integration token
# Then share the database with the integration (database menu > Connections)
NOTION_TOKEN=
NOTION_DATABASE_ID=
